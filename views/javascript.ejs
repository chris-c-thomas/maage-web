		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());

		gtag('config', '<%- request.applicationOptions.gaID %>', {
		  'link_attribution': true
		});
		</script>
	<% } %>


